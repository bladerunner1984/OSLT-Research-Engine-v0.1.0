      },
      "title": "Comparative Support Index",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "excluded_result_ids": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Result Ids",
      "type": "array"
    },
    "human_review_required": {
      "title": "Human Review Required",
      "type": "boolean"
    },
    "included_result_ids": {
      "items": {
        "type": "string"
      },
      "title": "Included Result Ids",
      "type": "array"
    },
    "leading_models": {
      "items": {
        "type": "string"
      },
      "title": "Leading Models",
      "type": "array"
    },
    "limiting_dimension": {
      "title": "Limiting Dimension",
      "type": "string"
    },
    "limiting_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Limiting Score",
      "type": "number"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "synthesis_id": {
      "title": "Synthesis Id",
      "type": "string"
    },
    "unresolved_contradictions": {
      "items": {
        "$ref": "#/$defs/ContradictionAssessment"
      },
      "title": "Unresolved Contradictions",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
