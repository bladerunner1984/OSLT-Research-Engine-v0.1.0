  "required": [
    "synthesis_id",
    "run_id",
    "included_result_ids",
    "excluded_result_ids",
    "comparative_support_index",
    "leading_models",
    "unresolved_contradictions",
    "limiting_dimension",
    "limiting_score",
    "claim_tier",
    "bounded_conclusion",
    "human_review_required"
