{
  "$defs": {
    "ClaimTier": {
      "enum": [
        "DESCRIPTIVE_EVIDENCE_ONLY",
        "ASSOCIATION_ONLY",
        "LIMITED_CAUSAL_EVIDENCE",
        "MODERATE_TRIANGULATED_CAUSAL_EVIDENCE",
        "HIGH_TRIANGULATED_CAUSAL_EVIDENCE",
        "THEORY_DEPENDENT_INTERPRETATION",
        "SIMULATION_ONLY"
      ],
      "title": "ClaimTier",
      "type": "string"
    },
    "ContradictionAssessment": {
      "properties": {
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "left_result_id": {
          "title": "Left Result Id",
          "type": "string"
        },
        "right_result_id": {
          "title": "Right Result Id",
          "type": "string"
        }
      },
      "required": [
        "left_result_id",
        "right_result_id",
        "classification",
        "explanation"
      ],
      "title": "ContradictionAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
