    },
    "finding_direction": {
      "$ref": "#/$defs/FindingDirection"
    },
    "kernel_name": {
      "title": "Kernel Name",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model_family": {
      "$ref": "#/$defs/ModelFamily"
