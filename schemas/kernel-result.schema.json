          "type": "string"
        },
        "estimand": {
          "minLength": 1,
          "title": "Estimand",
          "type": "string"
        },
        "jurisdiction": {
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "period": {
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        }
