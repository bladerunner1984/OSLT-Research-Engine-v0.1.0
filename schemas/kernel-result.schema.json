    "model_impacts": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Model Impacts",
      "type": "object"
    },
    "narrative": {
      "title": "Narrative",
      "type": "string"
    },
    "proposition_id": {
      "title": "Proposition Id",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeContext"
    },
    "uncertainty": {
      "title": "Uncertainty",
      "type": "string"
    }
