  "required": [
    "result_id",
    "run_id",
    "proposition_id",
    "kernel_name",
    "model_family",
    "scope",
    "finding_direction",
    "epistemic_status",
    "uncertainty",
    "certainty",
    "evidence_ids",
    "claim_tier",
    "narrative"
  ],
  "title": "KernelResult",
  "type": "object"
}