          "type": "number"
        },
        "source_independence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Source Independence",
          "type": "number"
        },
        "specification_stability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Specification Stability",
          "type": "number"
        },
        "statistical_precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Statistical Precision",
          "type": "number"
        },
        "temporal_ordering": {
          "maximum": 1,
          "minimum": 0,
          "title": "Temporal Ordering",
          "type": "number"
        },
        "theory_independence": {
          "maximum": 1,
          "minimum": 0,
