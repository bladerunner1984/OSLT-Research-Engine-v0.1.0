      "title": "ClaimTier",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "OBSERVATION",
        "MEASUREMENT",
        "ASSOCIATION",
        "CAUSAL_INFERENCE",
        "INTERPRETATION",
        "SIMULATION",
        "RECOMMENDATION"
