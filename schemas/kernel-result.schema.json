        "temporal_ordering",
        "causal_identification",
        "confounding_control",
        "selection_bias_control",
        "missing_data_robustness",
        "specification_stability",
        "source_independence",
        "cross_method_convergence",
        "replication",
        "transportability",
        "publication_selection_control",
        "provenance_completeness",
