    },
    "epistemic_status": {
      "$ref": "#/$defs/EpistemicStatus"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "falsifier_status": {
      "$ref": "#/$defs/FalsifierStatus",
